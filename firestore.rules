rules_version = '2';

// SoIM CGPA Tracking System — Firestore security rules
//
// The app's sign-in screen only gates its own UI. Firestore itself is a
// public endpoint by default — anyone who knows your project's client
// config (which is not a secret, and is visible in your deployed page's
// source, same as any Firebase web app) can talk to it directly unless
// rules say otherwise. These rules are that "otherwise".
//
// Two roles: admins can read and write everything; viewers can only read.
// EDIT THIS: replace the placeholder emails below with your real ones —
// HOP/HOS and yourself under admins, everyone else under viewers. Every
// request is checked by email only, not by which sign-in method was used —
// Firestore can't tell Google and email/password sign-ins apart, so your
// own email/password account needs to be listed under admins here too, or
// it will lose write access. Keep this file and the app's Settings ->
// "Admin emails" / "Viewer emails" lists in sync; update all three
// whenever someone's access changes.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'you@gmail.com',
          'hop@gmail.com',
          'hos@gmail.com'
        ];
    }

    function isViewer() {
      return request.auth != null
        && request.auth.token.email in [
          'colleague@gmail.com'
        ];
    }

    match /records/{recordId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    match /subjectMappings/{mappingId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
