rules_version = '2';

// SoIM CGPA Tracking System — Firestore security rules
//
// The app's sign-in screen only gates its own UI. Firestore itself is a
// public endpoint by default — anyone who knows your project's client
// config (which is not a secret, and is visible in your deployed page's
// source, same as any Firebase web app) can talk to it directly unless
// rules say otherwise. These rules are that "otherwise".
//
// Two roles: admins can read and write everything; viewers can only read.
// The list of who's in each role lives in Firestore itself now (the
// roles/config document below), not hardcoded here — every device reads
// the same shared list, so there's no separate copy to keep in sync per
// browser. An email not in EITHER list is always blocked, no exceptions.
//
// Bootstrapping a brand new project: the very first person to sign in
// becomes the founding admin automatically (the app writes roles/config
// with just their email under admins). After that document exists, only
// existing admins can change it — so this only ever fires once per
// project. If you ever need to reset who has access, an admin can delete
// the roles/config document directly in the Firestore console, and the
// next person to sign in becomes the new founding admin.

service cloud.firestore {
  match /databases/{database}/documents {

    function rolesDoc() {
      return get(/databases/$(database)/documents/roles/config).data;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/config)
        && request.auth.token.email in rolesDoc().admins;
    }

    function isViewer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/config)
        && request.auth.token.email in rolesDoc().viewers;
    }

    match /roles/config {
      // Any signed-in user can read this — it's how the app (and these
      // rules, via the functions above) determines a role in the first
      // place. It reveals who has access, not any student data, so this
      // is an acceptable trade-off for breaking the bootstrap deadlock.
      allow read: if request.auth != null;
      // Writable by an existing admin, OR by anyone at all if this
      // document doesn't exist yet (the one-time bootstrap).
      allow write: if request.auth != null
        && (!exists(/databases/$(database)/documents/roles/config) || isAdmin());
    }

    match /records/{recordId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    match /subjectMappings/{mappingId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    match /config/subjectAlternatives {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    match /config/archivedBatches {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
